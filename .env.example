# Exemplo seguro: copie para .env e substitua todos os CHANGE_ME.
# Nunca versione .env, tokens, credenciais, dumps, uploads ou certificados.

FRONTEND_URL=https://whitelabel.usekonnex.com
BACKEND_URL=https://api-whitelabel.usekonnex.com
PROXY_PORT=

# O orçamento do pool deve considerar todas as réplicas e deixar conexões
# reservadas para migrations, observabilidade e administração.
DB_NAME=whitelabel
DB_USER=whitelabel
DB_PASS=CHANGE_ME
DB_POOL_MAX=20
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000

# O Redis desta stack contém auth state/leases, não somente cache descartável.
# Configure maxmemory/eviction deliberadamente antes de impor limite de memória.
REDIS_PASS=CHANGE_ME
REDIS_OPT_LIMITER_MAX=1
REDIS_OPT_LIMITER_DURATION=3000
JWT_SECRET=CHANGE_ME
JWT_REFRESH_SECRET=CHANGE_ME
REDIS_SECRET_KEY=CHANGE_ME
MASTER_KEY=CHANGE_ME
ENV_TOKEN=CHANGE_ME
COMPANY_TOKEN=CHANGE_ME
# Tokens Bearer da API /api/messages pertencem a cada conexão e devem ser
# criados/rotacionados pela aplicação; nunca os grave neste arquivo.
API_RATE_LIMIT_MAX=60
API_RATE_LIMIT_WINDOW_SECONDS=60
# Gere com CSPRNG e provisione fora do Git antes de ativar credenciais digest.
API_TOKEN_PEPPER=CHANGE_ME_MINIMUM_32_RANDOM_BYTES
API_TOKEN_ROTATION_GRACE_SECONDS=900
ADMIN_EMAIL=admin@whitelabel.usekonnex.com
ADMIN_PASSWORD=CHANGE_ME
SUPPORT_NUMBER=
USER_LIMIT=10
CONNECTIONS_LIMIT=10
CLOSED_SEND_BY_ME=true
VERIFY_TOKEN=whitelabel-konnex
BULL_BOARD=false
SENTRY_DSN=
MP_ACCESS_TOKEN=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
# Tempo mínimo, em ms, antes de um envio PROCESSING exigir decisão humana (1 min–7 dias).
DISPATCH_RECONCILIATION_STALE_MS=900000
